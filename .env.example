# ==============================================================================
# Serve Locally Official Website - Environment Configuration
# ==============================================================================

# Canonical Site URL (Used for SEO, Open Graph & Canonical Tags)
NEXT_PUBLIC_SITE_URL=https://servelocally.github.io

# Contact Form API Architecture
# ------------------------------------------------------------------------------
# Option 1: Forward submissions to your PC's local receiver service
# (e.g. via Cloudflare Tunnel, ngrok, or Tailscale Funnel)
# Example: CONTACT_API_URL=https://submissions.yourdomain.com/api/receive
CONTACT_API_URL=

# Shared Secret Key between Next.js and your local receiver service
CONTACT_API_SECRET=your_secure_secret_token_change_me_in_production

# Direct Storage Option (When running Next.js locally or on self-hosted VPS)
# Excel workbook file path (stored outside the public folder)
CONTACT_STORAGE_PATH=./storage/contact_submissions.xlsx

# Fallback developer email displayed when local receiver is offline
NEXT_PUBLIC_CONTACT_EMAIL=Khushwinder.dev@gmail.com
NEXT_PUBLIC_GITHUB_URL=https://github.com/Khushwinder-Dev
NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/in/khushwinder-dev
NEXT_PUBLIC_PORTFOLIO_URL=https://khushwinder-dev.github.io

